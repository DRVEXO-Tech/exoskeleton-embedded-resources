        <mxCell id="cell2" value="DRVEXO OTA完整流程图（根据 CoreV1.3 / Motor_Steadywin / Bootloader_Motor 当前代码）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1760" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cell3" value="手机 / BLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="250" height="44" as="geometry" />
