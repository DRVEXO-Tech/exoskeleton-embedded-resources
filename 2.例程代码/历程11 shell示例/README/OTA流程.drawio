        <mxCell id="edge40" value="BLE ACK 0x02: ack=0/1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="cell10" target="cell9">
          <mxGeometry relative="1" as="geometry" />
