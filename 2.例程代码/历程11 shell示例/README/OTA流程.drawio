        <mxCell id="edge42" value="写页/更新断点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="cell13" target="cell14">
          <mxGeometry relative="1" as="geometry" />
