        <mxCell id="cell4" value="主控 CoreV1.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cell5" value="外置 Flash W25N01KV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cell6" value="电机 APP&#xa;Motor_Steadywin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="90" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cell7" value="电机 Bootloader&#xa;Bootloader_Motor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="90" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cell8" value="协议速查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="90" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cell9" value="发送 OTA Start&#xa;BLE功能码 0x07&#xa;payload:&#xa;[0..3]version_le&#xa;[4]target:0主控/1电池/2左电机/3右电机&#xa;[5..8]total_size_le&#xa;[9..10]seq_total_le" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="160" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cell10" value="APP_BLE -&gt; APP_Bootloader_Start&#xa;校验 target / total_size / seq_total&#xa;seq_total = ceil(total_size / 2048)&#xa;删除 IMU / Baro 轮询任务&#xa;选择目标 Flash 分区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cell11" value="擦除目标固件区&#xa;Core: block 2-3&#xa;Bat: block 6-7&#xa;Left: block 10-11&#xa;Right: block 14-15&#xa;状态区: block 1020 + target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cell12" value="发送 OTA Data&#xa;BLE功能码 0x08&#xa;payload:&#xa;[0..255]固件数据&#xa;[256..257]seq_le&#xa;8个256B小包组成1个2048B大包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="350" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell13" value="APP_Bootloader_HandleData&#xa;seq 必须等于 current_seq&#xa;缓存到 page_buf&#xa;满 2048B 或最后不足一页时写入 Flash&#xa;更新 receive_seq / receive_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell14" value="写 W25N01KV 页面&#xa;每个 seq 对应 1 页 2048B&#xa;断点状态同步写入状态区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="350" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell15" value="发送 OTA Finish&#xa;BLE功能码 0x09&#xa;payload:&#xa;[0..3]整包 crc32_le" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cell16" value="APP_Bootloader_HandleFinish&#xa;读取 Flash 全量固件&#xa;计算 CRC32 并和 payload 对比&#xa;成功后设置:&#xa;updata_falg=1&#xa;updata_finish=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="540" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell17" value="固件已缓存完成&#xa;等待目标设备升级&#xa;Flash_Status_data[target]&#xa;保存 version / total_size / crc32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="540" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell18" value="target 是左/右电机&#xa;且 pending?&#xa;(updata_falg=1&#xa;updata_finish=0)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="365" y="730" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cell19" value="APP_Bootloader_Motor_AutoStartCheck&#xa;创建 MotorBootloader 任务&#xa;选择 Left_Motor 或 Right_Motor&#xa;暂停主控心跳 ID 0x302" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="890" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cell20" value="主控发送电机 OTA 开始命令&#xa;FDCAN ID: 左0x300 / 右0x301&#xa;len=20&#xa;[0]=37(CAN_CMD_MOTOR_OTA_START)&#xa;[1..4]version_le&#xa;[5..8]total_size_le&#xa;[9..12]fdcan_packet_count_le&#xa;[13..16]crc32_le&#xa;[17..19]=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1060" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cell21" value="电机 APP 解析命令37&#xa;APP_Bootloader_Motor_Start&#xa;保存到用户配置:&#xa;OTA_Status=0xD0D0D0D0&#xa;version / total_size&#xa;fdcan_packet_count / crc32&#xa;回复ACK后 NVIC_SystemReset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="1060" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cell22" value="电机 Bootloader 启动&#xa;读取用户配置&#xa;OTA_Status==MAGIC_STATUS 时进入 OTA&#xa;接收ID: 左0x304 / 右0x305" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1060" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell23" value="等待主控准备&#xa;每 50ms 发送 BOOT_CODE&#xa;ID: 左0x400 / 右0x401&#xa;len=1, data[0]=0x66" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1240" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cell24" value="主控 Motor_OTA_Start / Wait&#xa;收到 0x66 后回复 READY&#xa;ID: 左0x304 / 右0x305&#xa;len=1, data[0]=0x00&#xa;随后静默等待 100ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1240" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cell25" value="主控发送 OTA 数据包&#xa;FDCAN ID: 左0x304 / 右0x305&#xa;len=64&#xa;[0..55]固件数据，不足补0xFF&#xa;[56..59]packet_index_le&#xa;[60..61]crc16 over [0..59]&#xa;[62..63]保留0xFF&#xa;50ms 未收到 READY 则重发当前包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1430" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cell26" value="Bootloader 接收 len64&#xa;校验 CRC16&#xa;packet_index 必须等于 expected&#xa;写入 APP_START_ADDR + index*56&#xa;expected++ / received_size += valid_len&#xa;回复 READY 0x00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1430" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cell27" value="所有 packet 发完&#xa;主控发送 FINISH&#xa;FDCAN ID: 左0x304 / 右0x305&#xa;len=1, data[0]=0x01&#xa;50ms 未收到 READY 则重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1670" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cell28" value="Bootloader 收到 0x01&#xa;检查 received_size 和 packet_count&#xa;计算 APP CRC32 == 配置 crc32&#xa;进入 FINISH_ACK&#xa;每20ms回复READY，共8次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1670" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cell29" value="Bootloader 返回 OK&#xa;跳转 APP_START_ADDR&#xa;运行新电机 APP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1880" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cell30" value="电机 APP 启动后仍看到&#xa;OTA_Status=0xD0D0D0D0&#xa;每20ms发送 APP_CONFIRM&#xa;ID: 左0x400 / 右0x401&#xa;len=1, data[0]=0x77" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="1880" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cell31" value="主控 Motor_OTA_AppConfirm&#xa;收到 0x77 后回复 0x77&#xa;ID: 左0x304 / 右0x305&#xa;len=1, data[0]=0x77&#xa;300ms 静默后清主控状态标志&#xa;恢复心跳 ID 0x302" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="1880" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cell32" value="本目标完成&#xa;如果另一侧电机仍 pending 则回到 Data_Prepare&#xa;否则删除 MotorBootloader 任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="2100" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cell33" value="FDCAN ID速查&#xa;Core -&gt; 左电机控制: 0x300&#xa;Core -&gt; 右电机控制: 0x301&#xa;左/右普通ACK: 0x000 / 0x001&#xa;Core -&gt; 左OTA通道: 0x304&#xa;Core -&gt; 右OTA通道: 0x305&#xa;左/右OTA回复: 0x400 / 0x401&#xa;Core心跳: 0x302（电机OTA期间暂停）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1515" y="160" width="255" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cell34" value="单字节码速查&#xa;0x66: BOOT_CODE&#xa;电机 Bootloader -&gt; 主控&#xa;0x00: READY_CODE&#xa;双方ACK/继续发送&#xa;0x01: FINISH_CODE&#xa;主控通知数据发送完&#xa;0x77: APP_CONFIRM&#xa;新电机APP启动确认" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1515" y="450" width="255" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cell35" value="BLE OTA速查&#xa;0x07 OTA_START&#xa;version + target + total_size + seq_total&#xa;0x08 OTA_DATA&#xa;最多256B数据 + seq&#xa;0x09 OTA_FINISH&#xa;crc32&#xa;主控回复BLE ACK功能码0x02&#xa;ack=0成功 / ack=1失败" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1515" y="710" width="255" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cell36" value="重试与异常&#xa;开始命令: 500ms超时重发&#xa;数据包: 50ms超时重发当前包&#xa;FINISH: 50ms超时重发0x01&#xa;Bootloader重复收到旧包(index&lt;expected)仍回复0x00&#xa;index&gt;expected 或 CRC16错则忽略" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1515" y="1010" width="255" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cell37" value="关键长度&#xa;BLE大包seq: 2048B&#xa;BLE小包: 256B&#xa;FDCAN OTA有效数据: 56B&#xa;FDCAN OTA总帧: 64B&#xa;电机OTA包数:&#xa;ceil(total_size / 56)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1515" y="1310" width="255" height="220" as="geometry" />
        </mxCell>
        <mxCell id="edge38" value="BLE 0x07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="cell9" target="cell10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge39" value="擦除/写状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="cell10" target="cell11">
          <mxGeometry relative="1" as="geometry" />
